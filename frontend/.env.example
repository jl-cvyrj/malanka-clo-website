# Frontend configuration.
#
# The browser calls the API through this Next.js app (a relative "/api/..."
# base), and the rewrite in next.config.ts proxies those requests to the
# backend. This keeps cookies first-party and avoids CORS.
#
# Set to empty so the browser uses a same-origin relative URL.
NEXT_PUBLIC_API_BASE_URL=
# Absolute backend origin used by the proxy and by server-side rendering.
# Local:  http://localhost:8080
# Render: https://<your-backend>.onrender.com
BACKEND_ORIGIN=http://localhost:8080
